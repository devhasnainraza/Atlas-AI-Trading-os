# Atlas local environment template (Spec 00 FR-007).
# Copy to repo root as .env — PLACEHOLDER VALUES ONLY, never commit real secrets.

# Environment: local | development | staging | production | test
ATLAS_ENV=local
ATLAS_SERVICE_NAME=atlas-api
ATLAS_LOG_LEVEL=INFO

# Dependencies (compose service defaults)
ATLAS_DATABASE_URL=postgresql+asyncpg://atlas:atlas_local_dev@localhost:5432/atlas
ATLAS_REDIS_URL=redis://localhost:6379/0
ATLAS_KAFKA_BOOTSTRAP_SERVERS=localhost:19092

# HTTP
ATLAS_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
ATLAS_RATE_LIMIT_DEFAULT_PER_MINUTE=120

# Feature flags — GitOps-managed JSON file, hot-reloaded on change.
# Leave unset to use static in-code defaults (all fail-closed).
ATLAS_FEATURE_FLAGS_FILE=infra/flags/flags.json

# Object storage (MinIO local)
ATLAS_S3_ENDPOINT=http://localhost:9000
ATLAS_S3_ACCESS_KEY=atlas
ATLAS_S3_SECRET_KEY=atlas_local_dev   # placeholder — local MinIO only

# ---------------------------------------------------------------------------
# Trading (Spec 03)
#
# NO VENUE CREDENTIALS HERE. API keys, MT5 logins, and OANDA tokens live in the
# Spec 01 encrypted credential vault and are fetched per operation. A key in a
# .env file is a key in every developer's shell history and every crash dump.
#
# Monetary values must be written as decimal strings, not floats.
# ---------------------------------------------------------------------------

# Master switch for real-money transmission. This is one of TWO switches: the
# flag `trading.live_orders.enabled` must also be true. Both default to false.
TRADING_LIVE_ORDERS_ENABLED=false
# Require a fresh step-up MFA for live connections and mandate grants.
TRADING_REQUIRE_STEP_UP_FOR_LIVE=true

# Order intent lifetime and drift tolerance. An intent that outlives its quote
# must expire rather than be submitted at a price nobody agreed to.
TRADING_INTENT_TTL_SECONDS=60
TRADING_INTENT_MAX_PRICE_DRIFT_PERCENT=0.5

# Submission timeout. On timeout the order becomes `unresolved` and is NEVER
# auto-retried — reconciliation asks the venue, the only authority on whether
# the order exists.
TRADING_SUBMIT_TIMEOUT_SECONDS=10.0
TRADING_UNRESOLVED_ALERT_AFTER_SECONDS=300

# Sync and reconciliation cadences (seconds).
TRADING_RECONCILE_INTERVAL_SECONDS=300
TRADING_RECONCILE_ON_RECONNECT=true
TRADING_ACCOUNT_SYNC_INTERVAL_SECONDS=60
TRADING_POSITION_SYNC_INTERVAL_SECONDS=30

# Default risk limits applied when a user has no policy of their own.
# Unset means "no limit from defaults" — a user policy still applies.
# TRADING_DEFAULT_MAX_ORDER_NOTIONAL=10000
# TRADING_DEFAULT_MAX_POSITION_NOTIONAL=50000
# TRADING_DEFAULT_MAX_OPEN_POSITIONS=10
# TRADING_DEFAULT_MAX_ORDERS_PER_HOUR=60

# Paper trading book.
TRADING_PAPER_STARTING_BALANCE=100000
TRADING_PAPER_SLIPPAGE_BPS=1
TRADING_PAPER_COMMISSION_BPS=0

# Sidecars. MT5 needs a Windows bridge; IBKR needs IB Gateway. Host and port
# must be set together. Leave unset when those venues are off.
# TRADING_MT5_BRIDGE_URL=http://localhost:8090
# TRADING_IBKR_GATEWAY_HOST=localhost
# TRADING_IBKR_GATEWAY_PORT=4002

# ---------------------------------------------------------------------------
# Market data (Spec 03)
#
# The freshness limits are what the risk gate fails closed on: a quote older
# than its window cannot price an order. Widening one widens what the platform
# is willing to trade against, so treat these as risk settings.
# ---------------------------------------------------------------------------

MARKETDATA_FRESHNESS_LIMIT_CRYPTO_SECONDS=3.0
MARKETDATA_FRESHNESS_LIMIT_FOREX_SECONDS=3.0
MARKETDATA_FRESHNESS_LIMIT_EQUITY_SECONDS=10.0
MARKETDATA_FRESHNESS_LIMIT_DEFAULT_SECONDS=10.0

# Redis TTL for the latest quote — expiry IS the staleness signal. Must exceed
# the widest freshness limit above, or fresh quotes get evicted and the gate
# refuses orders it should have priced. Startup fails if it does not.
MARKETDATA_QUOTE_CACHE_TTL_SECONDS=15

# Streaming and history caps.
MARKETDATA_MAX_SUBSCRIPTIONS_PER_USER=50
MARKETDATA_MAX_SYMBOLS_PER_QUOTE_REQUEST=100
MARKETDATA_MAX_BARS_PER_REQUEST=5000
MARKETDATA_BACKFILL_GAP_THRESHOLD_SECONDS=60

# Feed health.
MARKETDATA_FEED_HEARTBEAT_TIMEOUT_SECONDS=20.0
MARKETDATA_STREAM_RECONNECT_MAX_BACKOFF_SECONDS=60.0
MARKETDATA_SSE_KEEPALIVE_SECONDS=15.0

# ---------------------------------------------------------------------------
# Auth & identity (Spec 01)
#
# Values below are LOCAL DEVELOPMENT ONLY. `./scripts/bootstrap` generates the
# keypair and the two HMAC keys; they are not committed and not shared.
#
# Deployed environments supply key material through the secret manager, and
# startup REFUSES to run without it — see AuthSettings.validate_for_environment.
# There is no "insecure default" path that a forgotten variable falls back to.
# ---------------------------------------------------------------------------

# Token signing. ES256 (EC P-256). The public keys directory holds the current
# key plus the previous one, so tokens minted before a rotation still verify.
AUTH_JWT_ISSUER=http://localhost:8000
AUTH_JWT_AUDIENCE=atlas-api
AUTH_JWT_PRIVATE_KEY_PATH=.secrets/auth/jwt-signing-key.pem
AUTH_JWT_PUBLIC_KEYS_DIR=.secrets/auth/jwks
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_SIGNING_KEY_ROTATION_DAYS=90

# Sessions. Idle timeout ends unused sessions; the absolute lifetime ends every
# session regardless of activity. Cookies are Secure everywhere except plain
# http://localhost — and staging/production refuse AUTH_COOKIE_SECURE=false.
AUTH_REFRESH_IDLE_TIMEOUT_DAYS=14
AUTH_REFRESH_ABSOLUTE_LIFETIME_DAYS=90
AUTH_MAX_SESSIONS_PER_USER=20
AUTH_COOKIE_SECURE=false

# Password hashing (Argon2id) and policy. Cost parameters are stored per hash,
# so raising them rehashes on next login instead of invalidating passwords.
AUTH_ARGON2_MEMORY_KIB=65536
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_PARALLELISM=4
AUTH_PASSWORD_MIN_ZXCVBN_SCORE=3
AUTH_PASSWORD_HISTORY_DEPTH=5
# Breach screening uses the HIBP range API: only a 5-character SHA-1 prefix
# leaves the process, never the password or its full hash.
AUTH_BREACH_CHECK_ENABLED=true
AUTH_BREACH_CHECK_FAIL_OPEN=true

# Lockout. Per-account backoff after the free attempts are spent, plus a per-IP
# ceiling checked first so an attacker cannot cheaply lock a victim out.
AUTH_LOCKOUT_FREE_ATTEMPTS=5
AUTH_LOCKOUT_BACKOFF_SECONDS=[60,300,900,3600]
AUTH_IP_ATTEMPT_LIMIT_PER_MINUTE=20
AUTH_CAPTCHA_ENABLED=false

# MFA. TOTP only — SMS is excluded by design (SIM swap). Step-up freshness is
# how recently MFA must have been proven for a vault write, role grant, account
# deletion, or MFA disable to proceed.
AUTH_TOTP_ISSUER_NAME=Atlas
AUTH_TOTP_WINDOW_STEPS=1
AUTH_RECOVERY_CODE_COUNT=10
AUTH_STEP_UP_FRESHNESS_SECONDS=300

# One-time email tokens. Only a SHA-256 hash is stored, so a database leak
# exposes no usable link.
AUTH_EMAIL_VERIFY_TTL_HOURS=24
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_MAGIC_LINK_TTL_MINUTES=15
AUTH_RESEND_COOLDOWN_SECONDS=60

# Anomaly detection. 900 km/h between consecutive logins is airliner cruise:
# above it, one account was in two places at once. GeoIP is optional — absent,
# geo signals are skipped rather than guessed.
AUTH_IMPOSSIBLE_TRAVEL_KMH=900
AUTH_GEOIP_DATABASE_PATH=volumes/geoip/GeoLite2-City.mmdb

# Keyed hashes. AUTH_EMAIL_HASH_KEY is the HMAC key behind `email_hash` in
# login_failed events: abuse analysis can group attempts against one address
# without the event stream ever carrying the address.
# Generated by ./scripts/bootstrap — placeholders here, never real values.
AUTH_EMAIL_HASH_KEY=replace-me-local-only
AUTH_DEVICE_COOKIE_KEY=replace-me-local-only

# Privacy. Deletion is cancelable for the grace period, then irreversible.
AUTH_DELETION_GRACE_DAYS=14
AUTH_EXPORT_LINK_TTL_DAYS=7

# ---------------------------------------------------------------------------
# Social sign-in (Spec 01)
#
# All optional. With none configured, email/password and magic-link sign-in work
# unchanged and the provider list the UI renders is empty. A provider counts as
# configured only when its id AND secret are both present — half-configured
# means "off", never "try it and fail at the redirect".
#
# Use sandbox apps locally. Never paste a production client secret here.
# ---------------------------------------------------------------------------

OAUTH_REDIRECT_BASE_URL=http://localhost:8000/v1/auth/oauth
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# Apple signs its client secret as a JWT, so it needs the team/key identity
# rather than a static secret string.
# OAUTH_APPLE_CLIENT_ID=
# OAUTH_APPLE_TEAM_ID=
# OAUTH_APPLE_KEY_ID=
# OAUTH_APPLE_PRIVATE_KEY_PATH=.secrets/auth/apple-signing-key.p8

# ---------------------------------------------------------------------------
# Credential vault (Spec 01)
#
# READ THIS BEFORE CHANGING VAULT_KEK_PROVIDER.
#
# `local` reads the key-encryption key from VAULT_KEK_LOCAL below. That is a
# development affordance and staging/production REFUSE to start with it: a root
# key in an environment variable is a root key in every crash dump, process
# listing, and `docker inspect` output — which defeats the entire point of
# envelope encryption, whose purpose is to keep the KEK inside an HSM and out of
# application memory.
#
# Deployed environments set VAULT_KEK_PROVIDER=aws_kms (or gcp_kms) and
# VAULT_KMS_KEY_ID, and must NOT set VAULT_KEK_LOCAL at all.
# ---------------------------------------------------------------------------

VAULT_KEK_PROVIDER=local
# 32 bytes, base64. Generated by ./scripts/bootstrap. Losing it makes every
# stored credential permanently undecryptable — which is also what makes
# deletion real (crypto-shredding).
VAULT_KEK_LOCAL=replace-me-local-only
# VAULT_KMS_KEY_ID=arn:aws:kms:region:account:key/uuid
VAULT_KEK_ROTATION_DAYS=180

VAULT_MAX_CREDENTIALS_PER_USER=50
VAULT_MAX_VERSIONS_PER_CREDENTIAL=10
VAULT_REQUIRE_STEP_UP_FOR_WRITES=true
VAULT_VALIDATION_TIMEOUT_SECONDS=10.0
VAULT_MASKED_HINT_LENGTH=4

# ---------------------------------------------------------------------------
# Email (local: Mailpit catches everything, nothing leaves the machine)
# Web UI at http://localhost:8025
# ---------------------------------------------------------------------------

ATLAS_SMTP_HOST=localhost
ATLAS_SMTP_PORT=1025
ATLAS_SMTP_USE_TLS=false
ATLAS_EMAIL_FROM=no-reply@atlas.local
ATLAS_EMAIL_FROM_NAME=Atlas

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000
