# Next.js web app — dev target with hot reload; prod uses standalone output.
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json ./
COPY apps/web/package.json apps/web/
COPY packages/config/package.json packages/config/
COPY packages/ui/package.json packages/ui/
COPY packages/api-client/package.json packages/api-client/
RUN pnpm install --frozen-lockfile

FROM deps AS dev
COPY . .
EXPOSE 3000
CMD ["pnpm", "--dir", "apps/web", "dev"]

FROM deps AS build
COPY . .
RUN pnpm --dir apps/web build

FROM node:22-alpine AS prod
WORKDIR /app
RUN addgroup --system atlas && adduser --system --ingroup atlas atlas
COPY --from=build --chown=atlas:atlas /app/apps/web/.next/standalone ./
COPY --from=build --chown=atlas:atlas /app/apps/web/.next/static ./apps/web/.next/static
USER atlas
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
