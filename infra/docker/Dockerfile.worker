# Worker: outbox relay + event consumers (no HTTP surface).
FROM python:3.12-slim AS base
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY --from=ghcr.io/astral-sh/uv:0.6.3 /uv /usr/local/bin/uv
WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY shared/pyproject.toml shared/
COPY apps/api/pyproject.toml apps/api/
COPY services/worker/pyproject.toml services/worker/
COPY services/scheduler/pyproject.toml services/scheduler/
RUN uv sync --frozen --no-install-workspace

COPY shared/ shared/
COPY services/worker/ services/worker/
RUN uv sync --frozen --no-dev \
    && groupadd --system atlas \
    && useradd --system --gid atlas --create-home --home-dir /home/atlas atlas \
    && chown -R atlas:atlas /app /home/atlas
USER atlas
ENV PATH="/app/.venv/bin:$PATH" \
    HOME="/home/atlas" \
    UV_CACHE_DIR="/tmp/.uv_cache"
CMD ["python", "-m", "atlas_worker"]
