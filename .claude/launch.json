{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "atlas_api.main:create_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8010",
        "--reload"
      ],
      "port": 8010,
      "autoPort": false
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@atlas/web", "dev"],
      "port": 3000,
      "autoPort": false
    }
  ]
}
