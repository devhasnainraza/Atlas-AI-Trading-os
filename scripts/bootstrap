#!/usr/bin/env bash
# Bootstrap the local development environment: toolchain sync + sanity checks.
set -euo pipefail
cd "$(dirname "$0")/.."

echo "==> Checking prerequisites"
for tool in uv pnpm docker; do
  command -v "$tool" >/dev/null || { echo "ERROR: $tool is required but not installed"; exit 1; }
done

echo "==> Syncing Python workspace (uv)"
uv sync

echo "==> Installing TypeScript workspace (pnpm)"
pnpm install

if [ ! -f .env ]; then
  echo "==> Creating .env from infra/docker/.env.example (placeholders only)"
  cp infra/docker/.env.example .env
fi

# Local auth key material: ES256 signing keypair + JWKS, and the HMAC/KEK values
# in .env. Idempotent — an existing key is kept, because regenerating it would
# invalidate every session and make every stored credential undecryptable.
echo "==> Generating local auth keys (development only; deployed envs use KMS)"
uv run python scripts/gen_auth_keys.py

echo "==> Bootstrap complete. Next: docker compose -f infra/docker/compose.yaml up -d"
